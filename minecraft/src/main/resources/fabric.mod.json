{
  "schemaVersion": 1,
  "id": "skycraft",
  "version": "${version}",
  "name": "MCInBlender — SkyCraft Bridge",
  "description": "Minecraft simulation and geometry bridge for the Blender host; derived from SkyCraft.",
  "authors": ["chasmlol", "CS-LX"],
  "contact": {
    "sources": "https://github.com/CS-LX/MCInBlender"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.skycraft.SkyCraft"],
    "client": ["dev.skycraft.client.SkyCraftClient"]
  },
  "mixins": [
    "skycraft.mixins.json",
    { "config": "skycraft.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
